#!/bin/bash
# Yara 提交前自动体检钩子
# 在 git commit 之前自动运行 pre-commit-check.py

echo "🔍 运行提交前检查..."
python3 "$(git rev-parse --show-toplevel)/scripts/pre-commit-check.py"
if [ $? -ne 0 ] && [ $? -ne 2 ]; then
    echo "❌ 提交前检查未通过，提交已阻断。请修复后重新提交。"
    echo "   如需跳过检查，请使用 git commit --no-verify"
    exit 1
fi
echo "✅ 检查通过，继续提交"
